universe   = vanilla
executable = /bin/bash
getenv     = True

arguments  = ./scripts/david/run_depthbench_350m_sweep.sh $(lr) $(cfg) $(seed) $(Cluster)_$(Process)

request_cpus   = 16
request_memory = 256GB
request_gpus   = 4
requirements   = regexp("H100", TARGET.CUDADeviceName) && !regexp("g174", TARGET.Machine)

log    = condor_logs/depthbench_350m_cfg$(cfg_tag)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).log
output = condor_logs/depthbench_350m_cfg$(cfg_tag)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).out
error  = condor_logs/depthbench_350m_cfg$(cfg_tag)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).err

# Sweep LRs and 350M configs from README table.
queue lr,cfg,cfg_tag,seed from (
  2e-3,configs/llama_350M_24l_backbone.json,24l,42
  2e-3,configs/llama_350M_16l_backbone.json,16l,42
  #2e-3,configs/llama_350M_20l_backbone.json,20l,42
  #2e-3,configs/llama_350M_26l_backbone.json,26l,42
  #2e-3,configs/llama_350M_28l_backbone.json,28l,42
  #2e-3,configs/llama_350M_30l_backbone.json,30l,42
  2e-3,configs/llama_350M_32l_backbone.json,32l,42
)
