universe   = vanilla
executable = /bin/bash
getenv     = True

arguments  = ./scripts/david/run_depthbench_350m_sweep.sh $(lr) $(cfg) $(seed) $(Cluster)_$(Process) $(master_port)

request_cpus   = 16
request_memory = 256GB
request_gpus   = 4
requirements   = regexp("H100", TARGET.CUDADeviceName) && !regexp("i203", TARGET.Machine)

log    = condor_logs/depthbench_attnres_$(experiment)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).log
output = condor_logs/depthbench_attnres_$(experiment)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).out
error  = condor_logs/depthbench_attnres_$(experiment)_lr$(lr)_s$(seed)_$(Cluster)_$(Process).err

queue experiment,lr,cfg,seed,master_port from (
  logitscale,2e-3,configs/llama_400m_L24_attnres_logit_scale.json,42,35220
  topk025,2e-3,configs/llama_400m_L24_attnres_topk025.json,42,35221
)
